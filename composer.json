{
  "name": "gtfs-media/gtfs-realtime-php",
  "type": "library",
  "description": "GTFS Realtime protobuf bindings for PHP, generated from the official specification.",
  "keywords": ["gtfs", "gtfs-realtime", "transit", "protobuf"],
  "homepage": "https://gtfs.media",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "google/protobuf": "^4.33.6 || ^5.0"
  },
  "autoload": {
    "psr-4": {
      "Google\\Transit\\Realtime\\": "src/Google/Transit/Realtime",
      "GPBMetadata\\": "src/GPBMetadata"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload-dev": {
    "psr-4": {
      "GtfsMedia\\GtfsRealtime\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
