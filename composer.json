{
  "name": "gtfs-media/gtfs-realtime-php",
  "type": "library",
  "description": "GTFS Realtime protobuf bindings for PHP, generated from the official specification.",
  "keywords": [
    "gtfs",
    "gtfs-realtime",
    "gtfs-rt",
    "transit",
    "realtime",
    "protobuf",
    "vehicle-positions",
    "trip-updates",
    "service-alerts"
  ],
  "homepage": "https://gtfs.media",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1",
    "google/protobuf": "^4.33.6 || ^5.0"
  },
  "autoload": {
    "psr-4": {
      "Google\\Transit\\Realtime\\": [
        "src/Google/Transit/Realtime",
        "legacy/Google/Transit/Realtime"
      ],
      "GPBMetadata\\": "src/GPBMetadata"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5.62 || ^11.5.50 || ^12.5.8"
  },
  "autoload-dev": {
    "psr-4": {
      "GtfsMedia\\GtfsRealtime\\Tests\\": "tests"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "support": {
    "issues": "https://github.com/FivePaths/gtfs-realtime-php/issues",
    "source": "https://github.com/FivePaths/gtfs-realtime-php",
    "docs": "https://fivepaths.github.io/gtfs-realtime-php/"
  },
  "authors": [
    {
      "name": "FivePaths",
      "homepage": "https://fivepaths.com"
    }
  ],
  "suggest": {
    "ext-protobuf": "Replaces the pure-PHP protobuf runtime with the C implementation; much faster and leaner on large feeds"
  },
  "replace": {
    "lowa/gtfs-realtime-php": "1.0.0"
  }
}
